# PNet / EVE-NG Git Ignore
# Tránh commit các file nặng làm nghẽn Git và lệch nhịp môi trường

# Images giả lập (Dung lượng hàng chục GB - chia sẻ qua Drive/NAS riêng)
addons/qemu/*
addons/iol/bin/*
addons/dynamips/*
!addons/**/.gitkeep

# Temporary & runtime data
tmp/*
*.log
*.pid
/run/pnetlab/*
/ksm
/cpulimit

# User Labs cá nhân thử nghiệm
labs/test_*
labs/tmp_*

# OS & Editor generated files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Environment specific configurations
.env
config.local.php
data/telemetry/*.db
__pycache__/
*.pyc
html/vendor/
html/composer.lock

# =============================================================================
# SECURITY SENSITIVE FILES - Không bao giờ commit các file sau vào Git
# =============================================================================
# Credentials CSDL (chứa mật khẩu root MySQL dạng plaintext)
data/dbcreds.json
# Bản dump SQL backup (có thể chứa toàn bộ dữ liệu người dùng)
database_backup/*.sql
database_backup/
# File khóa lab tạm thời và lab rác khi test
labs/*.lock.flock
labs/abs.unl
# PKI / TLS private keys
data/extauth/
data/pki/
